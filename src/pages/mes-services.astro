---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
---

<BaseLayout
  title={`Mes services | ${siteConfig.name}`}
  description="Prestations éducatives et préventives EDAME : jeunes 8-16 ans, familles, écoles, médico-social. Prévention rupture scolaire, harcèlement, phobie scolaire et sociale."
  preloadImage="https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=640&q=75"
>
  <Header />
  <main>
    <section class="relative py-20 lg:py-28 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=800&q=75"
          srcset="https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=640&q=75 640w, https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=1024&q=75 1024w, https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=1920&q=80 1920w"
          sizes="100vw"
          alt=""
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="absolute inset-0 bg-eerie/45"></div>
      </div>
      <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl font-bold text-white">Mes services</h1>
        <p class="mt-4 text-xl text-white max-w-2xl">
          Des prestations éducatives et préventives pour agir tôt et ensemble
        </p>
      </div>
    </section>

    <section class="py-16 lg:py-24 bg-cream">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-eerie text-center mb-4">Pour qui ?</h2>
        <p class="text-xl text-eerie text-center max-w-2xl mx-auto mb-12">
          Jeunes entre 8 et 16 ans, parents, équipes éducatives et structures médico-sociales.
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white rounded-xl p-6 text-center shadow border-t-4 border-edame-green">
            <span class="text-3xl" aria-hidden="true">🧒</span>
            <p class="mt-2 font-semibold text-eerie">Jeunes</p>
          </div>
          <div class="bg-white rounded-xl p-6 text-center shadow border-t-4 border-sage">
            <span class="text-3xl" aria-hidden="true">👨‍👩‍👧</span>
            <p class="mt-2 font-semibold text-eerie">Familles</p>
          </div>
          <div class="bg-white rounded-xl p-6 text-center shadow border-t-4 border-edame-green">
            <span class="text-3xl" aria-hidden="true">🏫</span>
            <p class="mt-2 font-semibold text-eerie">Écoles</p>
          </div>
          <div class="bg-white rounded-xl p-6 text-center shadow border-t-4 border-sage">
            <span class="text-3xl" aria-hidden="true">🏥</span>
            <p class="mt-2 font-semibold text-eerie">Médico-social</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24 bg-sand">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        <div>
          <h2 class="text-2xl font-bold text-eerie flex items-center gap-3">
            <span class="w-3 h-10 bg-edame-green rounded-full" aria-hidden="true"></span>
            Objectifs
          </h2>
          <ul class="mt-6 space-y-3 text-lg text-eerie max-w-3xl">
            <li class="flex gap-2"><span class="text-sage font-bold">✓</span> Prévenir et réduire la rupture scolaire</li>
            <li class="flex gap-2"><span class="text-sage font-bold">✓</span> Agir sur le harcèlement scolaire</li>
            <li class="flex gap-2"><span class="text-sage font-bold">✓</span> Accompagner la phobie scolaire et la phobie sociale</li>
            <li class="flex gap-2"><span class="text-sage font-bold">✓</span> Proposer un accompagnement personnalisé et réfléchi</li>
          </ul>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-eerie flex items-center gap-3">
            <span class="w-3 h-10 bg-sage rounded-full" aria-hidden="true"></span>
            Modalités
          </h2>
          <p class="mt-6 text-lg text-eerie max-w-3xl leading-relaxed">
            Les interventions peuvent se dérouler selon les besoins : entretiens, ateliers, médiation, travail en réseau avec l'école ou les partenaires. Chaque demande fait l'objet d'un premier échange pour définir la meilleure réponse.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-8 lg:p-10 shadow-xl border border-sand">
          <h2 class="text-2xl font-bold text-eerie">Tarifs & devis</h2>
          <p class="mt-4 text-eerie leading-relaxed">
            Les prestations sont établies sur devis, en fonction du type d'intervention, de la durée et du public. Contactez-nous pour une proposition adaptée à votre situation.
          </p>
          <a href="/contact/" class="inline-flex items-center mt-6 px-6 py-3 bg-sage text-white font-semibold rounded-full hover:bg-sage-light transition-colors">
            Demander un devis
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 bg-sage">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold text-white">Une question sur nos services ?</h2>
        <a href="/contact/" class="inline-flex items-center mt-6 px-6 py-3 bg-edame-green text-white font-semibold rounded-full hover:bg-edame-green-dark transition-colors">
          Nous contacter
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config';
const phoneTel = siteConfig.contact.phone.replace(/\s/g, '');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'À partir de quel âge peut-on solliciter EDAME ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "L'accompagnement s'adresse à l'enfant à partir de 6 ans, en lien avec la famille et l'établissement scolaire, pour des difficultés scolaires, des situations de prévention ou de maintien de la scolarité.",
      },
    },
    {
      '@type': 'Question',
      name: 'Qui peut prendre contact en premier ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Les responsables légaux ou le médecin psychiatre peuvent écrire via le formulaire sur edame.fr. C'est le point d'entrée pour un premier échange.",
      },
    },
    {
      '@type': 'Question',
      name: 'Comment se déroule le premier contact ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Après le message envoyé depuis le site, un entretien téléphonique gratuit d'environ 15 minutes (ou des échanges par courriel) permet de valider la demande.",
      },
    },
    {
      '@type': 'Question',
      name: 'Où intervenez-vous ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'EDAME intervient autour de Lille, Dunkerque, Armentières et environs. Les séances peuvent avoir lieu à domicile ou en milieu scolaire, selon ce qui est convenu avec la famille.',
      },
    },
    {
      '@type': 'Question',
      name: "EDAME remplace-t-il l'école, les soins ou un suivi médical ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Non. L'accompagnement est un complément : il vise le lien école–maison–soins, la continuité de la scolarité et le travail avec les professionnels déjà impliqués.",
      },
    },
  ],
};
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description="EDAME, l'Educ A la Maison et A l'Ecole : accompagnement des familles, maintien de la scolarité, prévention, phobie scolaire. Leduc Delphine, éducatrice spécialisée. Lille, Dunkerque, Armentières."
  preloadImage="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=640&q=75"
>
  <Header />
  <main>
    <section class="relative overflow-hidden min-h-[70vh] flex items-center">
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=800&q=75"
          srcset="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=640&q=75 640w, https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=1024&q=75 1024w, https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=1920&q=80 1920w"
          sizes="100vw"
          alt=""
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="absolute inset-0 bg-eerie/55"></div>
      </div>
      <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
        <div class="max-w-2xl">
          <p class="text-edame-green font-semibold text-lg tracking-wide uppercase">{siteConfig.tagline}</p>
          <h1 class="mt-2 text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight">
            {siteConfig.name} : ton éduc à la maison et à l'école
          </h1>
          <p class="mt-6 text-xl text-white max-w-xl">
            Accompagnement des parents d'enfants en <strong class="text-edame-light">difficultés scolaires</strong> : prévention, maintien de la scolarité, lien école–soins et travail avec les professionnels de santé.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href="/mes-services/" class="inline-flex items-center px-6 py-3 bg-edame-btn text-white font-semibold rounded-full hover:bg-edame-btn-hover transition-colors shadow-lg">
              Modalités & services
            </a>
            <a href="/contact/" class="inline-flex items-center px-6 py-3 bg-white text-sage-dark font-semibold rounded-full hover:bg-sand transition-colors shadow-lg">
              Contact & formulaire
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24 bg-cream">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl lg:text-4xl font-bold text-eerie text-center">EDAME, c'est quoi ?</h2>
        <div class="mt-10 max-w-3xl mx-auto space-y-6 text-lg text-eerie leading-relaxed">
          <p>
            <strong>{siteConfig.name}</strong> « {siteConfig.tagline} » a été créé en <strong>{siteConfig.projectSince}</strong> par <strong>{siteConfig.founderName}</strong>, éducatrice spécialisée diplômée en <strong>2014</strong> à la <strong>HEH de Tournai</strong>.
          </p>
          <p>
            L'objectif d'EDAME est de permettre un <strong>accompagnement aux parents</strong> qui ont un ou plusieurs enfants présentant des <strong>difficultés scolaires</strong>. Nous visons à <strong>maintenir la scolarité</strong> de chaque enfant, à <strong>soutenir les familles</strong> et à être disponibles pour les <strong>établissements scolaires ordinaires et adaptés</strong>.
          </p>
          <p>
            Parce qu'avoir un trouble psychique ne doit pas être la cause de <strong>déscolarisation</strong>, de <strong>marginalisation</strong> ou de <strong>rupture de soins</strong>, EDAME est là dans les moments où le jeune a besoin d'un <strong>maillage entre la vie scolaire et ses moments de soins</strong>.
          </p>
          <p class="font-medium text-sage-dark">
            Prévention, accompagnement et aide à la scolarité, orientations, soutien à la parentalité, guidance parentale : les grands axes d'EDAME.
          </p>
        </div>
        <div class="text-center mt-12">
          <a href="/qui-suis-je/" class="inline-flex items-center text-sage-dark font-semibold hover:underline">
            Qui suis-je ?
            <span class="ml-2">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24 bg-sand">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-eerie text-center">EDAME, c'est aussi…</h2>
        <ul class="mt-10 max-w-3xl mx-auto space-y-4 text-lg text-eerie leading-relaxed list-disc pl-6">
          <li><strong>Ton éduc à la maison et à l'école.</strong></li>
          <li>Depuis {siteConfig.projectSince}, déjà une <strong>dizaine de familles</strong> dont le quotidien s'est apaisé et pour qui des pistes ont été données.</li>
          <li>Un <strong>projet unique à chacun</strong>, construit <strong>avec</strong> la famille — accompagnement court ou long, au <strong>rythme du jeune</strong>, avec des <strong>outils réfléchis et personnalisés</strong>.</li>
          <li>Le <strong>lien entre les familles et les écoles</strong>.</li>
          <li>Un travail en <strong>collaboration avec les PCPE</strong>, médecins traitants, psychiatres, psychologues…</li>
        </ul>
        <div class="text-center mt-10">
          <a href="/mes-services/" class="inline-flex items-center px-6 py-3 bg-sage-dark text-white font-semibold rounded-full hover:bg-sage transition-colors">
            Modalité d'un accompagnement & tarifs
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24 bg-cream">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-eerie text-center">Secteur d'intervention</h2>
        <p class="mt-6 text-xl text-eerie text-center max-w-2xl mx-auto">
          <strong>Lille</strong> — <strong>Dunkerque</strong> — <strong>Armentières</strong>
        </p>
      </div>
    </section>

    <section class="py-16 lg:py-24 bg-sand" aria-labelledby="faq-titre">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="faq-titre" class="text-3xl font-bold text-eerie text-center">Questions fréquentes</h2>
        <p class="mt-3 text-center text-eerie/80 text-lg max-w-2xl mx-auto">
          Réponses courtes — le détail des modalités est sur la page <a href="/mes-services/" class="text-sage-dark font-semibold underline hover:no-underline">Mes services</a>.
        </p>
        <div class="mt-10 space-y-3">
          <details class="group rounded-xl border border-sand bg-white shadow-sm open:shadow-md transition-shadow [open]:ring-2 [open]:ring-sage/20">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold text-eerie focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-dark/40 rounded-xl marker:content-none">
              <span>À partir de quel âge peut-on solliciter EDAME ?</span>
              <span class="shrink-0 text-sage-dark transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div class="border-t border-sand px-5 pb-5 pt-4 text-eerie/90 leading-relaxed">
              L'accompagnement s'adresse à l'enfant <strong>à partir de 6 ans</strong>, en lien avec la famille et
              l'établissement scolaire, pour des difficultés scolaires, des situations de prévention ou de
              maintien de la scolarité.
            </div>
          </details>
          <details class="group rounded-xl border border-sand bg-white shadow-sm open:shadow-md transition-shadow [open]:ring-2 [open]:ring-sage/20">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold text-eerie focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-dark/40 rounded-xl marker:content-none">
              <span>Qui peut prendre contact en premier ?</span>
              <span class="shrink-0 text-sage-dark transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div class="border-t border-sand px-5 pb-5 pt-4 text-eerie/90 leading-relaxed">
              Les <strong>responsables légaux</strong> ou le <strong>médecin psychiatre</strong> peuvent écrire via le
              formulaire sur edame.fr. C'est le point d'entrée pour un premier échange.
            </div>
          </details>
          <details class="group rounded-xl border border-sand bg-white shadow-sm open:shadow-md transition-shadow [open]:ring-2 [open]:ring-sage/20">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold text-eerie focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-dark/40 rounded-xl marker:content-none">
              <span>Comment se déroule le premier contact ?</span>
              <span class="shrink-0 text-sage-dark transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div class="border-t border-sand px-5 pb-5 pt-4 text-eerie/90 leading-relaxed">
              Après le message envoyé depuis le site, un <strong>entretien téléphonique gratuit d'environ 15 minutes</strong>{' '}
              (ou des échanges par courriel) permet de valider la demande. Les modalités complètes et tarifaires sont
              présentées sur <a href="/mes-services/" class="text-sage-dark font-semibold underline hover:no-underline">Mes services</a>.
            </div>
          </details>
          <details class="group rounded-xl border border-sand bg-white shadow-sm open:shadow-md transition-shadow [open]:ring-2 [open]:ring-sage/20">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold text-eerie focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-dark/40 rounded-xl marker:content-none">
              <span>Où intervenez-vous ?</span>
              <span class="shrink-0 text-sage-dark transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div class="border-t border-sand px-5 pb-5 pt-4 text-eerie/90 leading-relaxed">
              EDAME intervient autour de <strong>Lille</strong>, <strong>Dunkerque</strong>, <strong>Armentières</strong>{' '}
              et environs, selon faisabilité — les séances peuvent avoir lieu <strong>à domicile</strong> ou en{' '}
              <strong>milieu scolaire</strong>, selon ce qui est convenu avec la famille.
            </div>
          </details>
          <details class="group rounded-xl border border-sand bg-white shadow-sm open:shadow-md transition-shadow [open]:ring-2 [open]:ring-sage/20">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold text-eerie focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-dark/40 rounded-xl marker:content-none">
              <span>EDAME remplace-t-il l'école, les soins ou un suivi médical ?</span>
              <span class="shrink-0 text-sage-dark transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <div class="border-t border-sand px-5 pb-5 pt-4 text-eerie/90 leading-relaxed">
              Non. L'accompagnement est un <strong>complément</strong> : il vise le lien <strong>école–maison–soins</strong>, la
              continuité de la scolarité et le travail avec les professionnels déjà impliqués (école, santé, réseau).
            </div>
          </details>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <section class="py-16 lg:py-24 bg-sage-dark">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white">Premier contact</h2>
        <p class="mt-4 text-white text-lg">
          Les responsables légaux ou le médecin psychiatre peuvent nous joindre via le <strong>formulaire sur edame.fr</strong>, puis un appel gratuit de 15 minutes permet de valider la demande.
        </p>
        <p class="mt-2 text-white">
          <a href={`tel:${phoneTel}`} class="underline font-semibold">{siteConfig.contact.phone}</a>
          {' · '}
          <a href={`mailto:${siteConfig.contact.email}`} class="underline font-semibold break-all">{siteConfig.contact.email}</a>
        </p>
        <a href="/contact/" class="inline-flex items-center mt-8 px-8 py-4 bg-edame-btn text-white font-semibold rounded-full hover:bg-edame-btn-hover transition-colors shadow-lg">
          Formulaire de contact
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

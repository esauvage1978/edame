---
import { siteConfig } from '../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${siteConfig.name} — ${siteConfig.tagline}`,
  description:
    "Accompagnement des familles dont les enfants ont des difficultés scolaires : maintien de la scolarité, prévention, phobie scolaire, travail avec l'école et le réseau de soins. Public à partir de 6 ans. Lille, Dunkerque, Armentières.",
  url: siteConfig.siteUrl,
  email: siteConfig.contact.email,
  telephone: siteConfig.contact.phone.replace(/\s/g, ''),
  serviceType: 'Accompagnement éducatif spécialisé à domicile et en milieu scolaire',
  areaServed: [
    { '@type': 'City', name: 'Lille' },
    { '@type': 'City', name: 'Dunkerque' },
    { '@type': 'City', name: 'Armentières' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.contact.addressLine,
    postalCode: siteConfig.contact.codePostal,
    addressLocality: siteConfig.contact.ville,
    addressCountry: 'FR',
  },
  potentialAction: {
    '@type': 'ContactAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `mailto:${siteConfig.contact.email}`,
      actionPlatform: 'http://schema.org/ContactAction',
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

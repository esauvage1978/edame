---
import { siteConfig } from '../config';

const currentYear = new Date().getFullYear();
---

<footer class="bg-sage-dark text-white mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid md:grid-cols-3 gap-8">
      <div>
        <div class="inline-block rounded-xl bg-white p-3 shadow-sm">
          <img
            src="/image/cropped-logo-web-transparent-240.png"
            srcset="/image/cropped-logo-web-transparent-240.png 240w, /image/cropped-logo-web-transparent.png 500w"
            sizes="120px"
            alt="EDAME"
            class="h-12 w-auto object-contain"
            width="140"
            height="48"
            decoding="async"
          />
        </div>
        <p class="font-semibold text-lg mt-3">{siteConfig.name}</p>
        <p class="text-white text-sm mt-1">{siteConfig.tagline}</p>
        {siteConfig.linkedinUrl && (
          <a
            href={siteConfig.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-3 text-white hover:underline text-sm font-medium"
          >
            LinkedIn
          </a>
        )}
      </div>

      <div>
        <h3 class="font-semibold mb-3">Navigation</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/qui-suis-je/" class="text-white hover:underline transition-colors">Qui suis-je ?</a></li>
          <li><a href="/mes-services/" class="text-white hover:underline transition-colors">Mes services</a></li>
          <li><a href="/contact/" class="text-white hover:underline transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold mb-3">Contact</h3>
        <p class="text-white text-sm">
          {siteConfig.contact.addressLine}<br />
          {siteConfig.contact.codePostal} {siteConfig.contact.ville}
        </p>
        <p class="text-white text-sm mt-3">
          <a href={`tel:${siteConfig.contact.phone.replace(/\s/g, '')}`} class="hover:underline block">{siteConfig.contact.phone}</a>
        </p>
        <p class="text-white text-sm mt-2">
          <a href={`mailto:${siteConfig.contact.email}`} class="hover:underline break-all">{siteConfig.contact.email}</a>
        </p>
        <p class="text-white/90 text-sm mt-2">{siteConfig.contact.zone}</p>
      </div>
    </div>

    <div class="border-t border-white/20 mt-8 pt-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white">
        <p>© {currentYear} {siteConfig.name} — {siteConfig.tagline}. Tous droits réservés.</p>
        <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1 items-center">
          <li><a href="/mentions-legales/" class="text-white hover:underline transition-colors">Mentions légales</a></li>
          <li><a href="/politique-confidentialite/" class="text-white hover:underline transition-colors">Confidentialité</a></li>
          <li><a href="/cookies/" class="text-white hover:underline transition-colors">Politique cookies</a></li>
          <li>
            <button
              type="button"
              data-cookie-preferences
              class="text-white hover:underline transition-colors text-sm bg-transparent border-0 p-0 cursor-pointer font-sans"
            >
              Gérer les cookies
            </button>
          </li>
          <li><a href="/cgv/" class="text-white hover:underline transition-colors">CGV</a></li>
          <li><a href="/cgu/" class="text-white hover:underline transition-colors">CGU</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>

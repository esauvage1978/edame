---
import { siteConfig } from '../config';

const gaId = siteConfig.googleAnalyticsId;
---

<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-50 p-4 bg-eerie/95 text-white shadow-lg hidden">
  <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm sm:text-base">
      Ce site utilise des cookies pour son fonctionnement et le choix de vos préférences.
      <a href="/cookies/" class="underline hover:opacity-90">En savoir plus</a>
    </p>
    <div class="flex gap-3 flex-shrink-0">
      <button id="cookie-accept" class="px-4 py-2 bg-sage-dark text-white rounded-full text-sm font-medium hover:bg-sage transition-colors">
        Tout accepter
      </button>
      <button id="cookie-refuse" class="px-4 py-2 bg-white/20 rounded-full text-sm font-medium hover:bg-white/30 transition-colors">
        Refuser
      </button>
    </div>
  </div>
</div>

<script define:vars={{ gaId }}>
  (function () {
    var COOKIE_CONSENT_KEY = 'cookie-consent';
    /** ~13 mois, aligné CNIL / page « Gestion des cookies » */
    var COOKIE_CONSENT_DURATION = 395;
    var gtagLoaded = false;

    function loadGoogleAnalytics() {
      if (gtagLoaded || !gaId) return;
      gtagLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', gaId);
    }

    function setCookie(name, value, days) {
      var date = new Date();
      date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
      document.cookie = name + '=' + value + ';expires=' + date.toUTCString() + ';path=/;SameSite=Lax';
    }

    function getCookie(name) {
      var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
      return match ? match[2] : null;
    }

    function hideBanner() {
      var banner = document.getElementById('cookie-banner');
      if (banner) banner.classList.add('hidden');
    }

    function showBanner() {
      var banner = document.getElementById('cookie-banner');
      if (banner) banner.classList.remove('hidden');
    }

    var consent = getCookie(COOKIE_CONSENT_KEY);

    if (!consent) {
      showBanner();
    } else if (consent === 'accepted') {
      loadGoogleAnalytics();
    }

    var acceptBtn = document.getElementById('cookie-accept');
    if (acceptBtn) {
      acceptBtn.addEventListener('click', function () {
        setCookie(COOKIE_CONSENT_KEY, 'accepted', COOKIE_CONSENT_DURATION);
        loadGoogleAnalytics();
        hideBanner();
      });
    }

    var refuseBtn = document.getElementById('cookie-refuse');
    if (refuseBtn) {
      refuseBtn.addEventListener('click', function () {
        setCookie(COOKIE_CONSENT_KEY, 'refused', COOKIE_CONSENT_DURATION);
        hideBanner();
      });
    }

    function clearConsentCookie() {
      document.cookie =
        COOKIE_CONSENT_KEY + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;SameSite=Lax';
    }

    document.querySelectorAll('[data-cookie-preferences]').forEach(function (el) {
      el.addEventListener('click', function () {
        clearConsentCookie();
        window.location.reload();
      });
    });
  })();
</script>

---
import type { CollectionEntry } from 'astro:content';
import { formatDateFr } from '../utils/format';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, heroImageAlt, categories } = post.data;
const href = `/blog/${post.id}/`;
const heroSrc = heroImage.src;
---

<article class="group flex flex-col bg-white rounded-2xl shadow border border-sand overflow-hidden hover:shadow-md transition-shadow">
  <a href={href} class="block aspect-[16/9] overflow-hidden bg-sand">
    <img
      src={heroSrc}
      alt={heroImageAlt}
      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
      loading="lazy"
      decoding="async"
      width={heroImage.width}
      height={heroImage.height}
    />
  </a>
  <div class="flex flex-col flex-1 p-6">
    <div class="flex flex-wrap gap-2 mb-3">
      {categories.slice(0, 2).map((cat) => (
        <span class="text-xs font-semibold uppercase tracking-wide text-sage-dark bg-sand px-2 py-1 rounded">
          {cat}
        </span>
      ))}
    </div>
    <time datetime={pubDate.toISOString()} class="text-sm text-sage-dark">
      {formatDateFr(pubDate)}
    </time>
    <h2 class="mt-2 text-xl font-bold text-eerie group-hover:text-sage-dark transition-colors">
      <a href={href}>{title}</a>
    </h2>
    <p class="mt-3 text-eerie/90 text-sm leading-relaxed flex-1">{description}</p>
    <a
      href={href}
      class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-edame-dark hover:underline"
    >
      Lire l'article
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

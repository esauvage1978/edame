# .htaccess — Apache (site statique Astro EDAME)
# À déployer à la racine du site (même niveau que index.html).

# Encodage par défaut
AddDefaultCharset UTF-8

# Pas de listing des dossiers
Options -Indexes +FollowSymLinks

# Types MIME utiles
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType image/svg+xml .svg
  AddType application/javascript .mjs
</IfModule>

# Activer la réécriture
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www → sans www (décommenter si le domaine utilise www)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Forcer HTTPS (décommenter en production si certificat actif)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Trailing slash pour les URLs « répertoires » (pages Astro /contact/, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ $1/ [R=301,L]

  DirectoryIndex index.html index.htm
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresDefault "access plus 7 days"
</IfModule>

# Sitemap et robots : revalidation fréquente
<IfModule mod_headers.c>
  <FilesMatch "^(sitemap.*\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Fichiers cachés (.env, etc.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
